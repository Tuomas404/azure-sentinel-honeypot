// attack-stats.kql – honeypotin hyökkäystilasto (Windows-tapahtuma 4625)
// Ajo: Sentinel → law-honeypot → Logs (KQL mode).
// Laita kursori yhden kyselyn sisään ja paina Run, niin vain se ajetaan.
// Vaihda "OMA.IP" omaan IP:hesi VAIN portaalissa. Älä commitoi omaa IP:tä julkiseen repoon.
// Huom: tapahtumat ≠ kirjautumisyritykset (yksi yritys voi tuottaa useamman 4625:n).

// 1) Yhteenveto
let omatIPt = dynamic(["OMA.IP"]);
SecurityEvent
| where TimeGenerated >= datetime(2026-10-16) and TimeGenerated < datetime(2026-10-26)
| where EventID == 4625
| where isnotempty(IpAddress) and IpAddress != "-"
| where IpAddress !in (omatIPt)
| summarize Tapahtumat = count(), IP_osoitteet = dcount(IpAddress),
            Tunnukset = dcount(TargetUserName),
            Ensimmainen = min(TimeGenerated), Viimeisin = max(TimeGenerated)

// 2) IP-osoitteittain + maa (geolocation ≠ attribuutio)
let omatIPt = dynamic(["OMA.IP"]);
SecurityEvent
| where TimeGenerated >= datetime(2026-10-16) and TimeGenerated < datetime(2026-10-26)
| where EventID == 4625
| where isnotempty(IpAddress) and IpAddress != "-"
| where IpAddress !in (omatIPt)
| summarize Tapahtumat = count(), Tunnukset = make_set(TargetUserName, 10),
            Ensimmainen = min(TimeGenerated), Viimeisin = max(TimeGenerated)
            by IpAddress
| extend Maa = tostring(geo_info_from_ip_address(IpAddress).country)
| order by Tapahtumat desc

// 3) Kokeillut tunnukset
let omatIPt = dynamic(["OMA.IP"]);
SecurityEvent
| where TimeGenerated >= datetime(2026-10-16) and TimeGenerated < datetime(2026-10-26)
| where EventID == 4625
| where isnotempty(IpAddress) and IpAddress != "-"
| where IpAddress !in (omatIPt)
| summarize Tapahtumat = count(), IP_osoitteet = dcount(IpAddress) by TargetUserName
| order by Tapahtumat desc

// 4) Maittain
let omatIPt = dynamic(["OMA.IP"]);
SecurityEvent
| where TimeGenerated >= datetime(2026-10-16) and TimeGenerated < datetime(2026-10-26)
| where EventID == 4625
| where isnotempty(IpAddress) and IpAddress != "-"
| where IpAddress !in (omatIPt)
| extend Maa = tostring(geo_info_from_ip_address(IpAddress).country)
| summarize Tapahtumat = count(), IP_osoitteet = dcount(IpAddress) by Maa
| order by Tapahtumat desc

// 5) Tunneittain (UTC). Vain kokonaiset 24/7-vuorokaudet 19.–24.10.
//    (17.10. VM sammui klo 20 UTC, mikä vääristäisi jakaumaa.)
//    IP_osoitteet = montako eri hyökkääjää kunakin tuntina; yksi iso hyökkäys ei vääristä.
//    Kaavio: tulosten Chart-välilehti.
let omatIPt = dynamic(["OMA.IP"]);
SecurityEvent
| where TimeGenerated >= datetime(2026-10-19) and TimeGenerated < datetime(2026-10-26)
| where EventID == 4625
| where isnotempty(IpAddress) and IpAddress != "-"
| where IpAddress !in (omatIPt)
| summarize IP_osoitteet = dcount(IpAddress), Tapahtumat = count()
            by Tunti_UTC = hourofday(TimeGenerated)
| order by Tunti_UTC asc

// 6) Onnistuneet kirjautumiset verkosta, oma IP pois (odotus: ei tuloksia)
SecurityEvent
| where TimeGenerated between (datetime(2026-10-16) .. datetime(2026-10-26))
| where EventID == 4624 and LogonType in (3, 10)
| where IpAddress !in ("OMA.IP", "-", "", "127.0.0.1", "::1")
| summarize Lkm = count() by Account, LogonType, IpAddress

// 7) Epäonnistumisen syy: 0xc0000064 = tunnusta ei ole, 0xc000006a = väärä salasana, Status 0xc0000234 = lukittu
SecurityEvent
| where TimeGenerated between (datetime(2026-10-16) .. datetime(2026-10-26))
| where EventID == 4625 and IpAddress != "OMA.IP"
| summarize Tapahtumat = count(), IP_osoitteet = dcount(IpAddress) by SubStatus
| order by Tapahtumat desc

// 8) Olemassa olevat tunnukset, joihin osuttiin (väärä salasana tai lukittu)
SecurityEvent
| where TimeGenerated between (datetime(2026-10-16) .. datetime(2026-10-26))
| where EventID == 4625 and IpAddress != "OMA.IP"
| where SubStatus in ("0xc000006a", "0x0")
| summarize Tapahtumat = count(), IP_osoitteet = dcount(IpAddress),
            Ensimmainen_UTC = min(TimeGenerated), Viimeisin_UTC = max(TimeGenerated)
          by TargetUserName, Status, SubStatus
| order by Tapahtumat desc